{
  "$schema": "vscode://schemas/color-theme",
  "name": "Plotter Tide Night",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "#aab6d0",
    "descriptionForeground": "#8390ac",
    "disabledForeground": "#aab6d055",
    "errorForeground": "#f08a7a",
    "focusBorder": "#e98a5e99",
    "contrastBorder": "#00000000",
    "selection.background": "#aab6d038",
    "widget.shadow": "#00000066",
    "sash.hoverBorder": "#e98a5e",

    "textLink.foreground": "#f0a07a",
    "textLink.activeForeground": "#f6b897",
    "textPreformat.foreground": "#c8d1e4",
    "textPreformat.background": "#1c2333",
    "textBlockQuote.background": "#1a2030",
    "textBlockQuote.border": "#e98a5e88",
    "textCodeBlock.background": "#1a2030",

    "button.background": "#e98a5e",
    "button.foreground": "#141a27",
    "button.hoverBackground": "#f09c74",
    "button.secondaryBackground": "#232b3d",
    "button.secondaryForeground": "#aab6d0",
    "button.secondaryHoverBackground": "#2b3449",
    "checkbox.background": "#1c2333",
    "checkbox.border": "#aab6d040",

    "input.background": "#1c2333",
    "input.foreground": "#c8d1e4",
    "input.border": "#aab6d026",
    "input.placeholderForeground": "#aab6d066",
    "inputOption.activeBorder": "#e98a5e",
    "inputOption.activeBackground": "#e98a5e26",
    "dropdown.background": "#1c2333",
    "dropdown.border": "#aab6d026",
    "dropdown.foreground": "#c8d1e4",

    "badge.background": "#e98a5e",
    "badge.foreground": "#141a27",
    "progressBar.background": "#e98a5e",
    "scrollbar.shadow": "#00000000",
    "scrollbarSlider.background": "#aab6d01c",
    "scrollbarSlider.hoverBackground": "#aab6d030",
    "scrollbarSlider.activeBackground": "#aab6d044",

    "titleBar.activeBackground": "#0f131c",
    "titleBar.activeForeground": "#aab6d0",
    "titleBar.inactiveBackground": "#11161f",
    "titleBar.inactiveForeground": "#aab6d077",
    "titleBar.border": "#aab6d010",
    "menu.background": "#181e2c",
    "menu.foreground": "#aab6d0",
    "menu.selectionBackground": "#e98a5e",
    "menu.selectionForeground": "#141a27",
    "menu.separatorBackground": "#aab6d020",

    "activityBar.background": "#0f131c",
    "activityBar.foreground": "#c8d1e4",
    "activityBar.inactiveForeground": "#aab6d066",
    "activityBar.activeBorder": "#e98a5e",
    "activityBar.border": "#aab6d010",
    "activityBarBadge.background": "#e98a5e",
    "activityBarBadge.foreground": "#141a27",

    "sideBar.background": "#11161f",
    "sideBar.foreground": "#aab6d0",
    "sideBar.border": "#aab6d010",
    "sideBarTitle.foreground": "#c8d1e4",
    "sideBarSectionHeader.background": "#141a27",
    "sideBarSectionHeader.foreground": "#c8d1e4",
    "sideBarSectionHeader.border": "#aab6d010",

    "list.activeSelectionBackground": "#aab6d024",
    "list.activeSelectionForeground": "#dfe5f1",
    "list.inactiveSelectionBackground": "#aab6d016",
    "list.hoverBackground": "#aab6d00e",
    "list.focusOutline": "#e98a5e99",
    "list.highlightForeground": "#e98a5e",
    "list.errorForeground": "#f08a7a",
    "list.warningForeground": "#e2bd72",
    "tree.indentGuidesStroke": "#aab6d026",

    "editorGroupHeader.tabsBackground": "#11161f",
    "editorGroupHeader.tabsBorder": "#aab6d010",
    "editorGroup.border": "#aab6d010",
    "tab.activeBackground": "#141a27",
    "tab.activeForeground": "#dfe5f1",
    "tab.activeBorderTop": "#e98a5e",
    "tab.inactiveBackground": "#11161f",
    "tab.inactiveForeground": "#aab6d077",
    "tab.border": "#aab6d00c",
    "tab.hoverBackground": "#171d2b",
    "breadcrumb.foreground": "#aab6d088",
    "breadcrumb.focusForeground": "#dfe5f1",

    "editor.background": "#141a27",
    "editor.foreground": "#aab6d0",
    "editorCursor.foreground": "#e98a5e",
    "editor.lineHighlightBackground": "#aab6d00a",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#aab6d030",
    "editor.inactiveSelectionBackground": "#aab6d01a",
    "editor.selectionHighlightBackground": "#e98a5e1e",
    "editor.wordHighlightBackground": "#aab6d018",
    "editor.findMatchBackground": "#e98a5e48",
    "editor.findMatchHighlightBackground": "#e98a5e24",
    "editorLineNumber.foreground": "#aab6d04d",
    "editorLineNumber.activeForeground": "#c8d1e4",
    "editorIndentGuide.background1": "#aab6d014",
    "editorIndentGuide.activeBackground1": "#aab6d03a",
    "editorWhitespace.foreground": "#aab6d022",
    "editorRuler.foreground": "#aab6d014",
    "editorBracketMatch.background": "#e98a5e1e",
    "editorBracketMatch.border": "#e98a5e88",
    "editorWidget.background": "#181e2c",
    "editorWidget.border": "#aab6d020",
    "editorSuggestWidget.background": "#181e2c",
    "editorSuggestWidget.selectedBackground": "#aab6d022",
    "editorSuggestWidget.highlightForeground": "#e98a5e",
    "editorHoverWidget.background": "#181e2c",
    "editorHoverWidget.border": "#aab6d020",
    "editorGutter.addedBackground": "#8fbf94",
    "editorGutter.modifiedBackground": "#7f9ee0",
    "editorGutter.deletedBackground": "#e98a5e",
    "editorError.foreground": "#f08a7a",
    "editorWarning.foreground": "#e2bd72",
    "editorInfo.foreground": "#7f9ee0",
    "editorOverviewRuler.border": "#00000000",
    "minimap.background": "#141a27",

    "diffEditor.insertedTextBackground": "#8fbf9422",
    "diffEditor.removedTextBackground": "#e98a5e22",

    "panel.background": "#121824",
    "panel.border": "#aab6d018",
    "panelTitle.activeForeground": "#dfe5f1",
    "panelTitle.activeBorder": "#e98a5e",
    "panelTitle.inactiveForeground": "#aab6d066",

    "statusBar.background": "#0f131c",
    "statusBar.foreground": "#aab6d0",
    "statusBar.border": "#aab6d010",
    "statusBar.noFolderBackground": "#0f131c",
    "statusBar.debuggingBackground": "#e98a5e",
    "statusBar.debuggingForeground": "#141a27",
    "statusBarItem.remoteBackground": "#e98a5e",
    "statusBarItem.remoteForeground": "#141a27",
    "statusBarItem.hoverBackground": "#aab6d018",

    "notifications.background": "#181e2c",
    "notifications.foreground": "#aab6d0",
    "notifications.border": "#aab6d020",
    "quickInput.background": "#181e2c",
    "quickInputList.focusBackground": "#aab6d022",
    "pickerGroup.foreground": "#e98a5e",

    "terminal.background": "#121824",
    "terminal.foreground": "#aab6d0",
    "terminalCursor.foreground": "#e98a5e",
    "terminal.ansiBlack": "#1c2333",
    "terminal.ansiRed": "#f08a7a",
    "terminal.ansiGreen": "#9cc4a4",
    "terminal.ansiYellow": "#e2bd72",
    "terminal.ansiBlue": "#8fb0e8",
    "terminal.ansiMagenta": "#d79bc6",
    "terminal.ansiCyan": "#86c3cc",
    "terminal.ansiWhite": "#aab6d0",
    "terminal.ansiBrightBlack": "#5f6a85",
    "terminal.ansiBrightRed": "#e98a5e",
    "terminal.ansiBrightGreen": "#b3d6b9",
    "terminal.ansiBrightYellow": "#eccd8e",
    "terminal.ansiBrightBlue": "#a9c3f0",
    "terminal.ansiBrightMagenta": "#e4b3d6",
    "terminal.ansiBrightCyan": "#a2d4db",
    "terminal.ansiBrightWhite": "#dfe5f1",

    "gitDecoration.modifiedResourceForeground": "#8fb0e8",
    "gitDecoration.untrackedResourceForeground": "#9cc4a4",
    "gitDecoration.deletedResourceForeground": "#f08a7a",
    "gitDecoration.ignoredResourceForeground": "#aab6d055",
    "gitDecoration.conflictingResourceForeground": "#e2bd72"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#5f6a85", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"], "settings": { "foreground": "#e98a5e" } },
    { "scope": ["keyword.operator", "punctuation"], "settings": { "foreground": "#8390ac" } },
    { "scope": ["string", "string.template", "punctuation.definition.string"], "settings": { "foreground": "#9cc4a4" } },
    { "scope": ["constant.character.escape", "string.regexp"], "settings": { "foreground": "#86c3cc" } },
    { "scope": ["constant.numeric", "constant.language", "constant.other", "support.constant"], "settings": { "foreground": "#d79bc6" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#8fb0e8" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class"], "settings": { "foreground": "#e2bd72" } },
    { "scope": ["variable", "variable.other", "meta.definition.variable"], "settings": { "foreground": "#c8d1e4" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#aab6d0", "fontStyle": "italic" } },
    { "scope": ["variable.language", "variable.language.this"], "settings": { "foreground": "#e98a5e", "fontStyle": "italic" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#e98a5e" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#e2bd72" } },
    { "scope": ["support.type.property-name", "meta.object-literal.key"], "settings": { "foreground": "#8fb0e8" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#e98a5e", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#8fb0e8" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#9cc4a4" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#9cc4a4" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#f08a7a" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#8fb0e8" } },
    { "scope": ["invalid"], "settings": { "foreground": "#f08a7a" } }
  ]
}
