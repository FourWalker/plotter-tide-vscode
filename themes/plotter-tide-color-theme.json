{
  "$schema": "vscode://schemas/color-theme",
  "name": "Plotter Tide",
  "type": "light",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "#1f2a48",
    "descriptionForeground": "#4f5872",
    "disabledForeground": "#1f2a4866",
    "errorForeground": "#b23a2a",
    "focusBorder": "#c4552d99",
    "contrastBorder": "#00000000",
    "selection.background": "#1f2a4830",
    "widget.shadow": "#1f2a4822",
    "sash.hoverBorder": "#c4552d",

    "textLink.foreground": "#b04a26",
    "textLink.activeForeground": "#8f3818",
    "textPreformat.foreground": "#1f2a48",
    "textPreformat.background": "#e8d6bd88",
    "textBlockQuote.background": "#ece5d6",
    "textBlockQuote.border": "#c4552d88",
    "textCodeBlock.background": "#ece5d6",

    "button.background": "#c4552d",
    "button.foreground": "#fbf8f1",
    "button.hoverBackground": "#ad4724",
    "button.secondaryBackground": "#e8dfcc",
    "button.secondaryForeground": "#1f2a48",
    "button.secondaryHoverBackground": "#ded3bc",
    "checkbox.background": "#faf7f0",
    "checkbox.border": "#1f2a4840",

    "input.background": "#faf7f0",
    "input.foreground": "#1f2a48",
    "input.border": "#1f2a4826",
    "input.placeholderForeground": "#1f2a4870",
    "inputOption.activeBorder": "#c4552d",
    "inputOption.activeBackground": "#c4552d22",
    "dropdown.background": "#faf7f0",
    "dropdown.border": "#1f2a4826",
    "dropdown.foreground": "#1f2a48",

    "badge.background": "#c4552d",
    "badge.foreground": "#fbf8f1",
    "progressBar.background": "#c4552d",
    "scrollbar.shadow": "#00000000",
    "scrollbarSlider.background": "#1f2a481c",
    "scrollbarSlider.hoverBackground": "#1f2a4830",
    "scrollbarSlider.activeBackground": "#1f2a4844",

    "titleBar.activeBackground": "#e8dfcc",
    "titleBar.activeForeground": "#1f2a48",
    "titleBar.inactiveBackground": "#ece5d6",
    "titleBar.inactiveForeground": "#1f2a4888",
    "titleBar.border": "#1f2a4814",
    "menu.background": "#f6f2e9",
    "menu.foreground": "#1f2a48",
    "menu.selectionBackground": "#c4552d",
    "menu.selectionForeground": "#fbf8f1",
    "menu.separatorBackground": "#1f2a4820",

    "activityBar.background": "#e8dfcc",
    "activityBar.foreground": "#1f2a48",
    "activityBar.inactiveForeground": "#1f2a4877",
    "activityBar.activeBorder": "#c4552d",
    "activityBar.border": "#1f2a4814",
    "activityBarBadge.background": "#c4552d",
    "activityBarBadge.foreground": "#fbf8f1",

    "sideBar.background": "#ece5d6",
    "sideBar.foreground": "#1f2a48",
    "sideBar.border": "#1f2a4814",
    "sideBarTitle.foreground": "#1f2a48",
    "sideBarSectionHeader.background": "#e8dfcc",
    "sideBarSectionHeader.foreground": "#1f2a48",
    "sideBarSectionHeader.border": "#1f2a4814",

    "list.activeSelectionBackground": "#1f2a481f",
    "list.activeSelectionForeground": "#1f2a48",
    "list.inactiveSelectionBackground": "#1f2a4814",
    "list.hoverBackground": "#1f2a480d",
    "list.focusOutline": "#c4552d99",
    "list.highlightForeground": "#c4552d",
    "list.errorForeground": "#b23a2a",
    "list.warningForeground": "#a26a12",
    "tree.indentGuidesStroke": "#1f2a4826",

    "editorGroupHeader.tabsBackground": "#ece5d6",
    "editorGroupHeader.tabsBorder": "#1f2a4814",
    "editorGroup.border": "#1f2a4814",
    "tab.activeBackground": "#f3eee3",
    "tab.activeForeground": "#1f2a48",
    "tab.activeBorderTop": "#c4552d",
    "tab.inactiveBackground": "#ece5d6",
    "tab.inactiveForeground": "#1f2a4888",
    "tab.border": "#1f2a4810",
    "tab.hoverBackground": "#f0eadd",
    "breadcrumb.foreground": "#1f2a4899",
    "breadcrumb.focusForeground": "#1f2a48",

    "editor.background": "#f3eee3",
    "editor.foreground": "#1f2a48",
    "editorCursor.foreground": "#c4552d",
    "editor.lineHighlightBackground": "#1f2a480a",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#1f2a4826",
    "editor.inactiveSelectionBackground": "#1f2a4816",
    "editor.selectionHighlightBackground": "#c4552d1c",
    "editor.wordHighlightBackground": "#1f2a4814",
    "editor.findMatchBackground": "#c4552d40",
    "editor.findMatchHighlightBackground": "#c4552d22",
    "editorLineNumber.foreground": "#1f2a4859",
    "editorLineNumber.activeForeground": "#1f2a48",
    "editorIndentGuide.background1": "#1f2a4814",
    "editorIndentGuide.activeBackground1": "#1f2a4840",
    "editorWhitespace.foreground": "#1f2a4826",
    "editorRuler.foreground": "#1f2a4814",
    "editorBracketMatch.background": "#c4552d1c",
    "editorBracketMatch.border": "#c4552d88",
    "editorWidget.background": "#f6f2e9",
    "editorWidget.border": "#1f2a4820",
    "editorSuggestWidget.background": "#f6f2e9",
    "editorSuggestWidget.selectedBackground": "#1f2a481a",
    "editorSuggestWidget.highlightForeground": "#c4552d",
    "editorHoverWidget.background": "#f6f2e9",
    "editorHoverWidget.border": "#1f2a4820",
    "editorGutter.addedBackground": "#5a8a5e",
    "editorGutter.modifiedBackground": "#3d5a94",
    "editorGutter.deletedBackground": "#c4552d",
    "editorError.foreground": "#b23a2a",
    "editorWarning.foreground": "#b07a18",
    "editorInfo.foreground": "#3d5a94",
    "editorOverviewRuler.border": "#00000000",
    "minimap.background": "#f3eee3",

    "diffEditor.insertedTextBackground": "#5a8a5e22",
    "diffEditor.removedTextBackground": "#c4552d22",

    "panel.background": "#efe9dc",
    "panel.border": "#1f2a4820",
    "panelTitle.activeForeground": "#1f2a48",
    "panelTitle.activeBorder": "#c4552d",
    "panelTitle.inactiveForeground": "#1f2a4877",

    "statusBar.background": "#e8dfcc",
    "statusBar.foreground": "#1f2a48",
    "statusBar.border": "#1f2a4814",
    "statusBar.noFolderBackground": "#e8dfcc",
    "statusBar.debuggingBackground": "#c4552d",
    "statusBar.debuggingForeground": "#fbf8f1",
    "statusBarItem.remoteBackground": "#c4552d",
    "statusBarItem.remoteForeground": "#fbf8f1",
    "statusBarItem.hoverBackground": "#1f2a4814",

    "notifications.background": "#f6f2e9",
    "notifications.foreground": "#1f2a48",
    "notifications.border": "#1f2a4820",
    "quickInput.background": "#f6f2e9",
    "quickInputList.focusBackground": "#1f2a481a",
    "pickerGroup.foreground": "#c4552d",

    "terminal.background": "#efe9dc",
    "terminal.foreground": "#1f2a48",
    "terminalCursor.foreground": "#c4552d",
    "terminal.ansiBlack": "#1f2a48",
    "terminal.ansiRed": "#b23a2a",
    "terminal.ansiGreen": "#4a7a50",
    "terminal.ansiYellow": "#a26a12",
    "terminal.ansiBlue": "#3d5a94",
    "terminal.ansiMagenta": "#8a4a7a",
    "terminal.ansiCyan": "#2f7480",
    "terminal.ansiWhite": "#d8cfbd",
    "terminal.ansiBrightBlack": "#6b7290",
    "terminal.ansiBrightRed": "#c4552d",
    "terminal.ansiBrightGreen": "#5a8a5e",
    "terminal.ansiBrightYellow": "#b8832a",
    "terminal.ansiBrightBlue": "#5574b0",
    "terminal.ansiBrightMagenta": "#a2628f",
    "terminal.ansiBrightCyan": "#3f8a96",
    "terminal.ansiBrightWhite": "#faf7f0",

    "gitDecoration.modifiedResourceForeground": "#3d5a94",
    "gitDecoration.untrackedResourceForeground": "#4a7a50",
    "gitDecoration.deletedResourceForeground": "#b23a2a",
    "gitDecoration.ignoredResourceForeground": "#1f2a4866",
    "gitDecoration.conflictingResourceForeground": "#a26a12"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#8a8374", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"], "settings": { "foreground": "#c4552d" } },
    { "scope": ["keyword.operator", "punctuation"], "settings": { "foreground": "#5a6378" } },
    { "scope": ["string", "string.template", "punctuation.definition.string"], "settings": { "foreground": "#4a7a50" } },
    { "scope": ["constant.character.escape", "string.regexp"], "settings": { "foreground": "#2f7480" } },
    { "scope": ["constant.numeric", "constant.language", "constant.other", "support.constant"], "settings": { "foreground": "#8a4a7a" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#3d5a94" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class"], "settings": { "foreground": "#9a6416" } },
    { "scope": ["variable", "variable.other", "meta.definition.variable"], "settings": { "foreground": "#1f2a48" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#3a4566", "fontStyle": "italic" } },
    { "scope": ["variable.language", "variable.language.this"], "settings": { "foreground": "#c4552d", "fontStyle": "italic" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#c4552d" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#9a6416" } },
    { "scope": ["support.type.property-name", "meta.object-literal.key"], "settings": { "foreground": "#3d5a94" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#c4552d", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#3d5a94" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#4a7a50" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#4a7a50" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#b23a2a" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#3d5a94" } },
    { "scope": ["invalid"], "settings": { "foreground": "#b23a2a" } }
  ]
}
